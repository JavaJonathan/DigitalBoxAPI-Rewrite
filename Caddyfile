# Reverse proxy + automatic HTTPS for the DigitalBox API. Co-located on the Henderson box;
# this block lives alongside Henderson's api.hendersonsoftwarelabs.com block in the box's
# /etc/caddy/Caddyfile. DNS (Cloudflare): digitalbox-api A record -> 100.57.201.123, DNS-only
# (grey cloud) so Caddy can complete the ACME challenge directly.
digitalbox-api.hendersonsoftwarelabs.com {
	# Proxies the API and the SignalR hub at /hub/activity — Caddy passes WebSocket
	# upgrades through reverse_proxy transparently, no extra matcher needed.
	# Host port 8081: the co-located Henderson API already owns 8080 on this box.
	reverse_proxy localhost:8081

	# Reject oversized uploads at the edge, before they reach Kestrel and the 100 MB
	# RequestSizeLimit on POST /api/orders/upload.
	request_body {
		max_size 100MB
	}

	# Security headers. HSTS lives here because Caddy owns TLS (the container only speaks
	# HTTP); the app sets the nosniff/frame/referrer set too — this is defence in depth and
	# covers anything served straight from the proxy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
